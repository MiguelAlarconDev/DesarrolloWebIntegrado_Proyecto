# Variables de entorno de la plataforma (VALORES FICTICIOS). No guardes valores reales en el repositorio.
# En PowerShell:  $env:NOMBRE = "valor"   (iniciar_servicios.ps1 pide DB_PASSWORD sin eco)

# --- Base de datos (Supabase: usar "Session pooler", puerto 5432, sslmode=require) ---
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<ref-proyecto>
DB_PASSWORD=<no-guardar-aqui>
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# --- JWT compartido por auth, cursos, pedidos y gateway (>= 32 caracteres) ---
JWT_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>
JWT_EXPIRATION_MINUTES=60

# --- Mercado Pago (pedidos-service). Sin token no se crean preferencias ni se confirman pagos ---
MERCADOPAGO_ACCESS_TOKEN=TEST-<token-de-prueba>
MERCADOPAGO_WEBHOOK_SECRET=<clave-secreta-del-webhook>
MERCADOPAGO_BACK_URL=http://localhost:4200/checkout

# --- SMTP (auth y pedidos; comprobantes-service usa SMTP_* en su propio .env.example) ---
SPRING_MAIL_USERNAME=<correo@dominio>
SPRING_MAIL_PASSWORD=<contrasena-de-aplicacion>

# --- Meta WhatsApp Cloud API (pedidos-service) ---
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=<id-numero>
WHATSAPP_API_TOKEN=<token>
WHATSAPP_VERIFY_TOKEN=<token-verificacion-webhook>

# --- URLs internas (por defecto 127.0.0.1) ---
COMPROBANTES_SERVICE_URL=http://127.0.0.1:8084
WHATSAPP_SERVICE_URL=http://127.0.0.1:8085
